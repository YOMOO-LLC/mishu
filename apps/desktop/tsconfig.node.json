{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "electron"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@mishu/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@mishu/core": [
        "../../packages/core/src/index.ts"
      ],
      "@mishu/core/*": [
        "../../packages/core/src/*.ts"
      ],
      "@mishu/adapters-cloud": [
        "../../packages/adapters-cloud/src/index.ts"
      ],
      "@mishu/adapters-cloud/*": [
        "../../packages/adapters-cloud/src/*.ts"
      ],
      "@mishu/adapters-mock": [
        "../../packages/adapters-mock/src/index.ts"
      ],
      "@mishu/adapters-mock/*": [
        "../../packages/adapters-mock/src/*.ts"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "server/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "../../packages/**/*.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.ts",
    "../../tests/contract/**/*.ts"
  ]
}
