# Development reads .env from the source checkout. A packaged App reads
# ~/Library/Application Support/mishu/.env instead; keep it mode 0600.
# A short-lived Twilio Access Token generated by your backend. Never put the
# Twilio Account Auth Token in this file or in the Electron renderer.
TWILIO_ACCESS_TOKEN=
# Optional helper override (for example http://127.0.0.1:8787/token).
TWILIO_TOKEN_URL=
# Required by /token; use at least 32 bytes of random data.
APP_TOKEN_SECRET=

# Main-process Twilio credentials. Prefer Settings → Phone line (Twilio), which
# writes a protected local settings file. Explicit environment/.env values here
# override that file per field; LIVE_PHONE_USE_MOCKS overrides its saved mode.
# The packaged App signs short-lived access tokens when all four values exist.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_CLIENT_IDENTITY=mishu
TWILIO_PUBLIC_BASE_URL=https://your-public-host.example

# Optional overrides.
# Usually leave CODEX_BIN empty so the App discovers the Codex CLI through a login
# shell or common install paths. If needed, set an absolute executable path.
CODEX_BIN=
CODEX_WORKDIR=/path/to/a/project
LIVE_PHONE_USE_MOCKS=1

# Optional GPT-Live API voice (main process only; choose provider in Settings).
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
